__d(function (global, require, _$$_IMPORT_DEFAULT, _$$_IMPORT_ALL, module, exports, _dependencyMap) {
  "use strict";

  Object.defineProperty(exports, '__esModule', {
    value: true
  });
  Object.defineProperty(exports, "ar", {
    enumerable: true,
    get: function () {
      return ar;
    }
  });
  // Arabic UI dictionary. Keys are the English source strings used with t().
  // Keep {var} tokens identical to the English key.
  var ar = {
    "Discover and book top-rated hair salons, barbershops and beauty studios near you": "اكتشف واحجز أفضل صالونات الشعر ومحلات الحلاقة واستوديوهات التجميل بالقرب منك",
    "Online bookings around the clock, escrow-protected payments and a full dashboard for your team - built for salons and freelancers in Saudi Arabia.": "حجوزات عبر الإنترنت على مدار الساعة، ومدفوعات محمية بالضمان، ولوحة تحكم متكاملة لفريقك - صُممت للصالونات والمستقلين في المملكة العربية السعودية.",
    "Bink’s reminders make life so much easier. I also found a few good salons near me that I didn’t know existed.": "تذكيرات بينك تجعل حياتي أسهل بكثير. كما اكتشفت صالونات جيدة بالقرب مني لم أكن أعلم بوجودها.",
    "Booking my barber takes seconds now, and paying through the app means no waiting at the till. Highly recommend it!": "أصبح حجز حلاقي يستغرق ثوانٍ، والدفع عبر التطبيق يعني عدم الانتظار عند الكاشير. أنصح به بشدة!",
    "Riyadh": "الرياض",
    "Jeddah": "جدة",
    "Al Khobar": "الخبر",
    "Dammam": "الدمام",
    "Terms of Service": "شروط الخدمة",
    "Privacy Policy": "سياسة الخصوصية",
    "Last updated: {date}": "آخر تحديث: {date}",
    "Questions about this document? Contact us at support@bink.app.": "لديك أسئلة حول هذه الوثيقة؟ تواصل معنا على support@bink.app.",
    "These terms govern your use of the Bink platform - the website, mobile experience and related services. By creating an account or making a booking you agree to them, so please read them carefully. This document is a working draft prepared for review by legal counsel before public launch.": "تحكم هذه الشروط استخدامك لمنصة بينك - الموقع الإلكتروني وتجربة الجوال والخدمات المرتبطة بها. بإنشائك حسابًا أو إجرائك حجزًا فإنك توافق عليها، لذا يرجى قراءتها بعناية. هذه الوثيقة مسودة عمل مُعدّة للمراجعة من قِبل مستشار قانوني قبل الإطلاق العام.",
    "Who we are": "من نحن",
    "Bink is an online marketplace that connects customers with independent beauty businesses - salons, studios and freelance professionals (\"Providers\"). Bink facilitates discovery, booking, messaging and payment; the beauty services themselves are performed by the Providers, not by Bink.": "بينك سوق إلكتروني يربط العملاء بمنشآت التجميل المستقلة - الصالونات والاستوديوهات والمحترفين المستقلين («مقدمي الخدمة»). تسهّل بينك الاكتشاف والحجز والمراسلة والدفع؛ أما خدمات التجميل نفسها فيقدمها مقدمو الخدمة وليس بينك.",
    "Accounts": "الحسابات",
    "You can browse as a guest, but booking history, messaging, invoices and business tools require an account. You are responsible for keeping your credentials safe and for all activity under your account. Provider team members receive individual sign-ins with the access level their manager assigns.": "يمكنك التصفح كزائر، لكن سجل الحجوزات والمراسلة والفواتير وأدوات الأعمال تتطلب حسابًا. أنت مسؤول عن حماية بيانات دخولك وعن كل نشاط يتم عبر حسابك. يحصل أعضاء فريق مقدم الخدمة على حسابات دخول فردية بمستوى الصلاحية الذي يحدده مديرهم.",
    "Bookings": "الحجوزات",
    "A booking is a request for a specific service, time and professional at a Provider. The Provider may complete, reschedule or mark the appointment as a no-show. Availability shown on Bink reflects the Provider’s calendar at the time of booking.": "الحجز هو طلب خدمة محددة في وقت محدد لدى مختص معيّن عند مقدم الخدمة. يجوز لمقدم الخدمة إكمال الموعد أو إعادة جدولته أو تسجيله كعدم حضور. يعكس التوفر المعروض على بينك جدول مقدم الخدمة وقت الحجز.",
    "Cancellations, fees and deposits": "الإلغاء والرسوم والعرابين",
    "Each Provider sets its own cancellation policy, which is shown before you confirm a cancellation. Providers may charge a cancellation fee (a percentage of what you paid) and may require a reservation deposit to secure pay-at-venue bookings. Deposits are charged when you reserve and are held under the same protection as online payments.": "يضع كل مقدم خدمة سياسة الإلغاء الخاصة به، وتُعرض عليك قبل تأكيد الإلغاء. يجوز لمقدمي الخدمة فرض رسوم إلغاء (نسبة مما دفعته) وطلب عربون حجز لتأمين حجوزات الدفع في المقر. يُخصم العربون عند الحجز ويُحفظ بنفس حماية المدفوعات الإلكترونية.",
    "Payments and escrow": "المدفوعات والضمان",
    "Online payments (card or Apple Pay) are processed by our licensed payment partner; Bink does not store your card details. Amounts you pay online are held securely by Bink and released to the Provider only after the Provider marks your visit completed and you confirm it. Prices include 15% VAT and a tax invoice is issued automatically for every online payment.": "تُعالج المدفوعات الإلكترونية (بالبطاقة أو Apple Pay) عبر شريك الدفع المرخّص لدينا؛ ولا تخزّن بينك بيانات بطاقتك. تُحفظ المبالغ المدفوعة إلكترونيًا بأمان لدى بينك ولا تُحوَّل إلى مقدم الخدمة إلا بعد أن يحدد اكتمال زيارتك وتؤكدها أنت. تشمل الأسعار ضريبة القيمة المضافة 15%، وتصدر فاتورة ضريبية تلقائيًا لكل دفعة إلكترونية.",
    "Refunds": "استرداد المبالغ",
    "If a paid booking is cancelled or refunded before the escrow is released, the amount is returned to your original payment method, less any applicable cancellation fee under the Provider’s policy. Refunds are initiated by the Provider or by Bink support.": "إذا أُلغي حجز مدفوع أو استُرد قبل تحويل مبلغ الضمان، يُعاد المبلغ إلى وسيلة الدفع الأصلية بعد خصم أي رسوم إلغاء مطبقة وفق سياسة مقدم الخدمة. يبدأ الاسترداد من مقدم الخدمة أو من دعم بينك.",
    "Provider obligations": "التزامات مقدم الخدمة",
    "Providers must submit accurate business information, hold any licences their services require, honour confirmed bookings and set fair policies. New listings are reviewed by the Bink team before going live, and Bink may suspend listings that breach these terms.": "على مقدمي الخدمة تقديم معلومات دقيقة عن نشاطهم، وامتلاك التراخيص اللازمة لخدماتهم، والوفاء بالحجوزات المؤكدة، ووضع سياسات عادلة. يراجع فريق بينك الإدراجات الجديدة قبل نشرها، ويجوز لـ بينك إيقاف الإدراجات المخالفة لهذه الشروط.",
    "Reviews and content": "التقييمات والمحتوى",
    "You may review a Provider only after a completed visit. Reviews must be honest and respectful. Photos on Bink must not show people, faces or body parts. Bink may remove content that is unlawful, misleading or violates these rules, and ratings are recalculated when a review is removed.": "لا يمكنك تقييم مقدم الخدمة إلا بعد زيارة مكتملة. يجب أن تكون التقييمات صادقة ومحترمة. يجب ألا تُظهر الصور على بينك أشخاصًا أو وجوهًا أو أجزاء من الجسم. يجوز لـ بينك إزالة المحتوى غير القانوني أو المضلل أو المخالف لهذه القواعد، ويُعاد احتساب التقييمات عند إزالة أي تقييم.",
    "Acceptable use and blocking": "الاستخدام المقبول والحظر",
    "You must not misuse Bink - including fraudulent bookings, harassment through messaging, or attempts to circumvent payments. Bink may block accounts that violate these terms; blocked accounts cannot sign in, book, message or review.": "يُحظر إساءة استخدام بينك - بما في ذلك الحجوزات الاحتيالية، أو المضايقة عبر الرسائل، أو محاولات الالتفاف على المدفوعات. يجوز لـ بينك حظر الحسابات المخالفة لهذه الشروط؛ ولا يمكن للحسابات المحظورة تسجيل الدخول أو الحجز أو المراسلة أو التقييم.",
    "Liability": "المسؤولية",
    "Bink provides the platform \"as is\" and is not a party to the service agreement between you and a Provider. To the maximum extent permitted by law, Bink’s liability for any claim related to the platform is limited to the amounts you paid through Bink in the three months before the claim.": "توفر بينك المنصة «كما هي» وليست طرفًا في اتفاقية الخدمة بينك وبين مقدم الخدمة. وإلى أقصى حد يسمح به النظام، تنحصر مسؤولية بينك عن أي مطالبة متعلقة بالمنصة في المبالغ التي دفعتها عبر بينك خلال الأشهر الثلاثة السابقة للمطالبة.",
    "Changes to these terms": "التغييرات على هذه الشروط",
    "We may update these terms as the platform evolves. Material changes will be announced in the app, and continuing to use Bink after a change means you accept the updated terms.": "قد نحدّث هذه الشروط مع تطور المنصة. سيُعلن عن التغييرات الجوهرية داخل التطبيق، ويعني استمرارك في استخدام بينك بعد التغيير قبولك بالشروط المحدّثة.",
    "Governing law": "القانون الواجب التطبيق",
    "These terms are governed by the laws of the Kingdom of Saudi Arabia, and any dispute is subject to the exclusive jurisdiction of the competent courts of Riyadh.": "تخضع هذه الشروط لأنظمة المملكة العربية السعودية، ويختص بأي نزاع الاختصاص الحصري للمحاكم المختصة في الرياض.",
    "This policy explains what personal data Bink collects, why, and the choices you have. It applies to the Bink website and app, for customers, salon owners, freelancers and their team members alike. This document is a working draft prepared for review by legal counsel before public launch.": "توضح هذه السياسة البيانات الشخصية التي تجمعها بينك وأسباب جمعها والخيارات المتاحة لك. وتنطبق على موقع بينك وتطبيقه، للعملاء وأصحاب الصالونات والمستقلين وأعضاء فرقهم على حد سواء. هذه الوثيقة مسودة عمل مُعدّة للمراجعة من قِبل مستشار قانوني قبل الإطلاق العام.",
    "What we collect": "ما الذي نجمعه",
    "Account details (name, email, password hash), booking details (services, times, chosen professional, notes you add), messages you exchange with Providers, reviews, favorites, language preference, and payment metadata such as amounts, invoice numbers and transaction status. Card numbers are handled entirely by our payment partner and never touch Bink’s servers.": "بيانات الحساب (الاسم والبريد الإلكتروني وكلمة المرور المشفّرة)، وتفاصيل الحجوزات (الخدمات والأوقات والمختص المختار وملاحظاتك)، والرسائل المتبادلة مع مقدمي الخدمة، والتقييمات، والمفضلة، وتفضيل اللغة، وبيانات الدفع الوصفية مثل المبالغ وأرقام الفواتير وحالة المعاملات. أما أرقام البطاقات فيعالجها شريك الدفع بالكامل ولا تصل أبدًا إلى خوادم بينك.",
    "How we use it": "كيف نستخدمها",
    "To operate the marketplace: showing your appointments, delivering messages, issuing tax invoices, releasing escrow payments, sending booking notifications, and keeping the platform safe. We also use aggregate, de-identified data to understand how Bink is used and to improve it.": "لتشغيل السوق: عرض مواعيدك، وتوصيل الرسائل، وإصدار الفواتير الضريبية، وتحويل مدفوعات الضمان، وإرسال إشعارات الحجز، والحفاظ على أمان المنصة. كما نستخدم بيانات مجمّعة ومجهولة الهوية لفهم استخدام بينك وتحسينه.",
    "What Providers see": "ما يراه مقدمو الخدمة",
    "When you book, the Provider sees your name, the booking details, any notes you add, and your messages to them. Team members at a Provider see only the bookings and conversations assigned to them. Providers never see your payment credentials.": "عند الحجز، يرى مقدم الخدمة اسمك وتفاصيل الحجز وأي ملاحظات تضيفها ورسائلك إليه. ولا يرى أعضاء فريق مقدم الخدمة سوى الحجوزات والمحادثات المسندة إليهم. لا يرى مقدمو الخدمة بيانات الدفع الخاصة بك أبدًا.",
    "Sharing": "المشاركة",
    "We share data only with the service providers needed to run Bink - payment processing, cloud hosting and email delivery - under contracts that limit their use of it. We do not sell your personal data. We may disclose data where the law requires it.": "نشارك البيانات فقط مع مزودي الخدمات اللازمين لتشغيل بينك - معالجة المدفوعات والاستضافة السحابية وإرسال البريد الإلكتروني - بموجب عقود تقيّد استخدامهم لها. لا نبيع بياناتك الشخصية. وقد نفصح عن البيانات حيثما يقتضي النظام ذلك.",
    "Where your data lives": "أين تُحفظ بياناتك",
    "Bink runs on cloud infrastructure with the database hosted in the European Union, protected by row-level security so each account can only read the data it is entitled to. Access by the Bink team is limited to what operating and supporting the platform requires.": "تعمل بينك على بنية سحابية تُستضاف قاعدة بياناتها في الاتحاد الأوروبي، ومحمية بأمان على مستوى الصفوف بحيث لا يقرأ كل حساب إلا البيانات المخوّل بها. ويقتصر وصول فريق بينك على ما يتطلبه تشغيل المنصة ودعمها.",
    "Retention": "الاحتفاظ بالبيانات",
    "We keep your data while your account is active. Booking and invoice records are retained as required by Saudi tax regulations even after account deletion; other personal data is deleted or anonymised when your account is closed.": "نحتفظ ببياناتك ما دام حسابك نشطًا. ويُحتفظ بسجلات الحجوزات والفواتير وفق ما تقتضيه الأنظمة الضريبية السعودية حتى بعد حذف الحساب؛ أما البيانات الشخصية الأخرى فتُحذف أو تُجهّل عند إغلاق حسابك.",
    "Your rights": "حقوقك",
    "You can view and edit your profile in the app, and change your language at any time. To request a copy of your data or the deletion of your account, contact support@bink.app and we will respond within 30 days, subject to records we must keep by law.": "يمكنك عرض ملفك الشخصي وتعديله في التطبيق وتغيير لغتك في أي وقت. لطلب نسخة من بياناتك أو حذف حسابك، تواصل مع support@bink.app وسنرد خلال 30 يومًا، مع مراعاة السجلات التي يلزمنا النظام بالاحتفاظ بها.",
    "Local storage": "التخزين المحلي",
    "Bink stores a small amount of data on your device - your session, language choice and interface preferences - so the app works and remembers you. We do not use third-party advertising trackers.": "تخزّن بينك قدرًا صغيرًا من البيانات على جهازك - جلستك واختيار اللغة وتفضيلات الواجهة - ليعمل التطبيق ويتذكرك. لا نستخدم متتبعات إعلانية من جهات خارجية.",
    "Children": "الأطفال",
    "Bink is not directed at children under 16, and we do not knowingly collect their data. If you believe a child has created an account, contact us and we will remove it.": "لا تستهدف بينك الأطفال دون سن 16 عامًا، ولا نجمع بياناتهم عن قصد. إذا كنت تعتقد أن طفلًا أنشأ حسابًا، تواصل معنا وسنقوم بإزالته.",
    "Changes to this policy": "التغييرات على هذه السياسة",
    "If we materially change how we handle personal data, we will announce it in the app before the change takes effect. The date at the top of this page always reflects the latest version.": "إذا غيّرنا جوهريًا طريقة تعاملنا مع البيانات الشخصية، فسنعلن ذلك في التطبيق قبل سريان التغيير. ويعكس التاريخ أعلى هذه الصفحة أحدث نسخة دائمًا.",
    "July 14, 2026": "14 يوليو 2026",
    "Sign in or create an account to view this page.": "سجّل الدخول أو أنشئ حسابًا لعرض هذه الصفحة.",
    "Salon owners and freelancers use the same business account and dashboard.": "أصحاب الصالونات والمستقلون يستخدمون نفس حساب الأعمال ولوحة التحكم نفسها.",
    "Salon owner or freelancer? Log in with the same account - you’ll land straight in your business dashboard.": "صاحب صالون أو مستقل؟ سجّل الدخول بالحساب نفسه - وستصل مباشرةً إلى لوحة تحكم أعمالك.",
    "List your salon - or yourself as a freelancer - to get your business dashboard.": "أدرج صالونك - أو نفسك كمستقل - للحصول على لوحة تحكم أعمالك.",
    "Log in with your business account - salons and freelancers use the same login.": "سجّل الدخول بحساب الأعمال الخاص بك - الصالونات والمستقلون يستخدمون نفس تسجيل الدخول.",
    "Viewing as {name}": "تتصفح باسم {name}",
    "Exit": "خروج",
    "View as user": "عرض كمستخدم",
    "Block": "حظر",
    "Unblock": "إلغاء الحظر",
    "Blocked": "محظور",
    "This account has been blocked by the Bink team.": "تم حظر هذا الحساب من قِبل فريق بينك.",
    "Payments": "المدفوعات",
    "Reviews": "التقييمات",
    "Waiting for your approval": "بانتظار موافقتك",
