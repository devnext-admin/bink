# --- Supabase (cloud project) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Payments ---
# 'demo' (default) simulates the gateway locally: bookings, transactions and
# invoices all work with no keys. Set to 'moyasar' once the edge functions are
# deployed and secrets are set (see README "Activate payments").
EXPO_PUBLIC_PAYMENTS_GATEWAY=demo
