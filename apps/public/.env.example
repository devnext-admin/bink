# Expo reads .env from the app root, which is this directory. A .env at the
# repo root is NOT picked up since the workspace split. Copy this to .env.
#
# Every EXPO_PUBLIC_* value is baked into the bundle at build time, so rebuild
# after changing any of them. The build scripts pass --clear for that reason:
# a cached bundle will happily ship the previous values.

# --- Supabase (cloud project) ---
# Live project: yxidiwkswariavopixmf. Leave blank to run on bundled demo data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Payments ---
# 'demo' simulates the gateway locally: bookings, transactions and invoices all
# work with no keys. Set to 'moyasar' once the edge functions are deployed.
EXPO_PUBLIC_PAYMENTS_GATEWAY=demo

# --- Admin console ---
# The admin app is deployed separately so its code never ships here. Entry
# points open this URL instead of routing in-app. Leave blank to hide them.
EXPO_PUBLIC_ADMIN_URL=https://bink-admin-v2.vercel.app
