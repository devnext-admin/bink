{
  "name": "bink-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @bink/public",
    "android": "npm run android --workspace @bink/public",
    "ios": "npm run ios --workspace @bink/public",
    "web": "npm run web --workspace @bink/public",
    "admin": "npm run web --workspace @bink/admin",
    "build:public": "npm run build --workspace @bink/public",
    "build:admin": "npm run build --workspace @bink/admin",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test e2e/security.test.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
